# Assets del juego (nunca al repo)
# NOTA: git no soporta comentarios inline — cada regla va sola en su línea.
# .client_files/: extracted client install (game_pak, bin32, ...) used locally
# by the server's ClientData and by tools. Never committed except its README.
.client_files/*
!.client_files/README.md
.server_files/
# Clientes descargados (.7z/.zip multi-volumen, ~158 GB). Suben a S3, no a git.
.clients/
*.sqlite3
game_pak

# Python
__pycache__/
*.pyc

# Config local
Config.Local.json

