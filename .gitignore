# Node
node_modules/

# Game assets (never committed)
# NOTE: git does not support inline comments - each rule goes on its own line.
# .client_files/: extracted client install (game_pak, bin32, ...) used locally
# by the server's ClientData and by tools. Never committed except its README.
.client_files/*
!.client_files/README.md
.server_files/
# Downloaded clients (multi-volume .7z/.zip, ~158 GB). They go to S3, not git.
.clients/
*.sqlite3
game_pak

# Python
__pycache__/
*.pyc

# Local config
Config.Local.json

# IDE
.vscode/
.idea/

# Accidental leftover file (bash redirect into a folder with a space)
/NUL

# ZCode harness
.zcode/

# Read-only external references (third-party source kept for study)
.reference/

# tools/ui local toolchain & artifacts
tools/ui/luac-build/*
!tools/ui/luac-build/luac5f.exe

tools/ui/console_capture.log

apps/*/src-tauri/target/

# extracted game assets (never commit)
game/
tools/ui/unluac.jar

tools/ui/decompiled/
