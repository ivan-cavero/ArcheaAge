{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcheaAge Launcher",
  "version": "0.1.0",
  "identifier": "dev.archeaage.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArcheaAge Launcher",
        "width": 1100,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}