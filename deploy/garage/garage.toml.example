# Copia a garage.toml junto a compose.yaml y rellena los dos secretos:
#   rpc_secret  = openssl rand -hex 32
#   admin_token = openssl rand -hex 32
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"

replication_factor = 1 # un solo nodo; si añades otro, >=2 y revisa el layout

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "CAMBIA-ME"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"

[s3_web]
bind_addr = "[::]:3902"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "CAMBIA-ME"
