---
import BaseLayout from "../layouts/BaseLayout.astro";
import es from "../i18n/es";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Servers from "../components/Servers.astro";
import Features from "../components/Features.astro";
import World from "../components/World.astro";
import Compare from "../components/Compare.astro";
import Portal from "../components/Portal.astro";
import Benchmarks from "../components/Benchmarks.astro";
import Roadmap from "../components/Roadmap.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";

const t = es;
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang="es">
  <Nav t={t} lang="es" />
  <main>
    <Hero t={t} />
    <Stats t={t} />
    <Servers t={t} />
    <Features t={t} />
    <World t={t} />
    <Compare t={t} />
    <Portal t={t} />
    <Benchmarks t={t} />
    <Roadmap t={t} />
    <CTA t={t} />
  </main>
  <Footer t={t} />
</BaseLayout>