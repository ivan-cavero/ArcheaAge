---
import type { Dict } from "../i18n/es";
import ArcadiaLogo from "./ArcadiaLogo.astro";

interface Props {
  t: Dict;
  lang: "es" | "en";
}

const { t, lang } = Astro.props;
const home = lang === "es" ? "/" : "/en/";
const links = [
  { href: "#servers", label: t.nav.servers },
  { href: "#project", label: t.nav.features },
  { href: "#world", label: t.nav.world },
  { href: "#portal", label: t.nav.portal },
  { href: "#roadmap", label: t.nav.roadmap },
];
---

<nav class="nav" id="site-nav">
  <div class="container nav-inner">
    <a class="brnd" href={home}>
      <ArcadiaLogo size={30} />
      <span class="brnd-txt">
        <span class="brand-aa">ArcheAge</span>
        <b>ARCADIA</b>
      </span>
    </a>
    <ul class="nav-links">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
    <div class="nav-right">
      <div class="lang-sw">
        <a href="/" class:list={{ on: lang === "es" }} data-lang="es">ES</a>
        <a href="/en/" class:list={{ on: lang === "en" }} data-lang="en">EN</a>
      </div>
      <a class="nav-cta btn btn-pri" href="#cta">{t.nav.download}</a>
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<script>
  // Mobile nav toggle + persist language choice (so auto-detect doesn't fight it).
  const nav = document.getElementById("site-nav");
  const btn = nav?.querySelector(".nav-toggle");
  btn?.addEventListener("click", () => {
    const open = nav!.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(open));
  });
  // Close the menu when a link is clicked.
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => nav!.classList.remove("open"))
  );
  // User picked a language explicitly → remember it (with a timestamp).
  document.querySelectorAll(".lang-sw a").forEach((a) =>
    a.addEventListener("click", () => {
      try {
        const v = a.getAttribute("data-lang") || (a.textContent?.trim().toLowerCase() ?? "es");
        localStorage.setItem("arcadia-lang", JSON.stringify({ v, t: Date.now() }));
      } catch {}
    })
  );
</script>